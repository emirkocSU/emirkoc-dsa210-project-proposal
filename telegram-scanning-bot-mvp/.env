# Telegram Bot Configuration
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BOT_USERNAME=test_car_bot

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./car_alert_bot.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Car Scanner Configuration
SCAN_INTERVAL=300
BASE_LISTING_URL=https://www.sahibinden.com/otomobil
MAX_LISTINGS_PER_SCAN=50
REQUEST_DELAY=1.0

# YOLOv8 Configuration
YOLO_WEIGHTS_PATH=models/car_damage_yolo.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_MAX_IMAGES=5

# Webhook Configuration
WEBHOOK_URL=
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook

# Development/Testing
DEBUG=False
TESTING=False

# Mobile App Integration
MOBILE_APP_SECRET=test_secret_key_for_development
DEEP_LINK_BASE_URL=https://test-app.com/link

# External Services
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Token Configuration
TOKEN_EXPIRATION_HOURS=24